{
  "installCommand": "(cd frontend 2>/dev/null && npm install --include=dev) || npm install --include=dev",
  "buildCommand": "(cd frontend 2>/dev/null && npm run build && cd .. && mkdir -p dist && cp -R frontend/dist/. dist/ 2>/dev/null) || npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/**",
      "maxDuration": 30
    }
  }
}
